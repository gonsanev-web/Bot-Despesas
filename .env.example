# Modelo do ficheiro .env. Copia este ficheiro, muda o nome para .env e preenche.
# NUNCA ponhas valores verdadeiros neste modelo: ele vai para o GitHub, o .env não.

# Em todo o lado (PC e alojamento): o token do @BotFather (completo, com os dois pontos) e o teu ID
BOT_TOKEN=
MEU_ID=

# Só no alojamento (PythonAnywhere):
# um texto secreto inventado por ti (o README diz como gerar)
WEBHOOK_SECRET=
# o endereço do teu site + /webhook, por exemplo https://TEUUTILIZADOR.pythonanywhere.com/webhook
WEBHOOK_URL=
# o intermediário das contas gratuitas da PythonAnywhere
PROXY_URL=http://proxy.server:3128
